# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"

# ── Chip revision: support ECO2 (v1.x) silicon ───────────────────────────
# IDF 6.0 default is REV_MIN_301 (rev 3.1+) which won't run on this ECO2.
# SELECTS_REV_LESS_V3 unlocks _0/_1/_100 options.  REV_MIN_1 = v0.1+, max
# REV_MAX_FULL=199, so binary supports any v0.1..v1.99 chip including ECO2.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ── Primary console on USB-Serial-JTAG ───────────────────────────────────
# /dev/ttyACM0 is the P4's native USB-Serial-JTAG, not UART0 (the latter
# is on header pins and not wired on this dev setup).  Keeping the
# primary console here lets the esp_console REPL bind input + output to
# the same port the developer connects to with picocom / idf.py monitor.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── DRAM pressure relief for mbedtls + ESP-Hosted SDIO ───────────────────
# Symptom (2026-05): WSS handshake fails with MBEDTLS_ERR_SSL_ALLOC_FAILED
# (-0x3B00) right after WiFi gets an IP, and the C6 SDIO RX path asserts
# at sdio_drv.c:953 because heap_caps_malloc(DMA) returns NULL.  Both are
# the same root cause: internal DRAM exhausted while bringing TLS up.
#
# 1. Default mbedtls allocator (was INTERNAL only) → big chunks land in
#    PSRAM via the global heap, only DMA-tagged allocs stay internal.
# 2. Lower the "always internal" threshold so allocations as small as 2 KB
#    can spill to PSRAM (IDF default was 16 KB, which kept almost
#    everything mbedtls touches in DRAM).
# 3. Keep the TLS *input* record buffer at the 16 KB TLS maximum.  An
#    earlier 4 KB setting (to trim WSS overhead) broke self-OTA: the
#    GitHub release CDN sends full-size TLS records, so reading the
#    response failed with mbedtls -0x0087 / "Complete headers were not
#    received".  Thanks to (1)+(2) this 16 KB buffer lands in PSRAM, so it
#    does NOT reintroduce the internal-DRAM cascade.  OUT stays small via
#    ASYMMETRIC_CONTENT_LEN (we never send big records).
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# Force software ECC — do NOT use the ESP32-P4 hardware ECC accelerator (2026-06).
# The HW ECC accelerator on this P4 returns wrong results for ECDSA *verification*:
# every ECDSA signature check fails with PSA_ERROR_INVALID_SIGNATURE (-0x95).
# Symptom: TLS to any ECDSA-cert server fails — github.com (Sectigo/USERTrust ECC)
# could not be reached for the OTA version check (cert-chain ECDSA verify failed,
# surfaced as x509 -0x2700), while RSA servers (the Let's Encrypt release CDN, the
# tunnel bridge) worked. Proven by disabling cert verification: the handshake then
# failed later at the ServerKeyExchange ECDSA verify (-0x95), same root cause.
# HARDWARE_ECDSA_VERIFY was already off but HARDWARE_ECC (the ECP point-mul accel)
# still routed verify through the buggy peripheral. Software ECC is slower but TLS
# handshakes here are infrequent (OTA + one tunnel connect). MUST live in defaults:
# the IDF default is =y, so a fullclean would otherwise reintroduce the bug.
CONFIG_MBEDTLS_HARDWARE_ECC=n

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y triggers GCC-15 -Werror=attributes due to
# inconsistent .iram section numbering in LVGL 9.5.0 sw blend code; leave off.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
# SysMon shows FPS / CPU overlay — useful for benchmarks, off in production.
# CONFIG_LV_USE_SYSMON is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_RENDER=y
CONFIG_LV_USE_DEMO_SCROLL=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_TRANSFORM=y
CONFIG_LV_USE_DEMO_MUSIC=y
CONFIG_LV_DEMO_MUSIC_AUTO_PLAY=y
CONFIG_LV_USE_DEMO_FLEX_LAYOUT=y
CONFIG_LV_USE_DEMO_MULTILANG=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BSP_JC4880P443C_LCD_BL_GPIO=23
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# ── ESP-Hosted: WiFi + BLE via ESP32-C6 co-processor over SDIO ───────────
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# DO NOT ENABLE CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM on this board.
# It moves the SDIO transport DMA pools (RX + common TX) to PSRAM and frees
# ~72 KB of steady-state internal DRAM (measured 2026-06) — but the SDIO *TX*
# DMA reading from PSRAM is not reliable here: under runtime load the write
# task hit ESP_ERR_TIMEOUT (258) → "Unrecoverable host sdio state" → hosted
# transport self-restart (esp_restart) after ~69 s. The single Kconfig switch
# steers both RX and TX with no RX-only option, so the transport instability
# rules it out. Left internal. See pio-idf-p4 SKILL §16.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# BLE via C6 co-processor virtual HCI (ESP-Hosted).
# NimBLE host runs on the P4; HCI packets are routed to the C6 over SDIO.
# CONFIG_BT_NIMBLE_ENABLED must be set before CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE
# is visible in Kconfig (it depends on BT_NIMBLE_ENABLED).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Disable UART HCI transport (default y when BT_CONTROLLER_DISABLED) so that
# the ESP_HOSTED_ENABLE_BT_NIMBLE Kconfig option becomes visible.
# The VHCI transport (ESP-Hosted → C6 over SDIO) is used instead.
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# Scan extended (BLE 5) advertisements as well as legacy ones.  Modern Victron
# devices (and BLE-5 phones) advertise on extended adverts; a legacy-only scan
# silently misses them (a phone sees them, the board does not).  Three knobs,
# all required — enabling EXT_ADV alone is NOT enough:
#   EXT_ADV  — compile extended advertising/scanning support (5.0 feature).
#   EXT_SCAN — actually scan for extended adverts (superset: still gets legacy).
#   EVT_SIZE — HCI event buffer.  Extended-adv reports exceed the legacy 70 B
#              and are truncated/dropped over the C6 VHCI transport otherwise.
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_TRANSPORT_EVT_SIZE=257

# ── NimBLE buffer trim — reclaim internal DRAM ───────────────────────────
# Internal SRAM runs critically low (~22 KB steady; dipped to 6 KB during the
# post-OTA self-test under weak BLE coverage → "heap floor breached" rollback).
# NimBLE's default pools are sized for high-throughput BLE; here it's passive
# scanning + a single periodic Ultimatron GATT poll. Trim the over-provisioned
# COUNTS (EVT_SIZE stays 257 for ext-adv reports) to free internal DRAM.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# Allocate the NimBLE host heap (msys pools, GATT/ATT state, host structures)
# from PSRAM instead of internal DRAM: heapdiag showed host init alone costs
# ~21 KB internal, which is what pushed the post-OTA self-test below the floor.
# Safe here because the host never DMAs from these buffers — HCI packets reach
# the C6 through the SDIO transport's own (internal, unchanged) mempool.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Web server: enable native WebSocket support in esp_http_server.
CONFIG_HTTPD_WS_SUPPORT=y
# Post-handshake callback fires once per new WS client → bump wsClientCount
# accurately (the URI handler is invoked only for frames, never for the
# upgrade leg, so we cannot count clients from inside it).
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# LWIP global socket pool.  Each tunneled browser request uses 2 LWIP fds
# (our client side + the httpd-accepted side), plus the httpd listener,
# the WSS control client, and a handful for WiFi/DHCP/DNS.  Default of 10
# is exhausted as soon as a browser fetches a multi-asset page through
# the tunnel; raise to comfortably hold ~8 concurrent streams.
CONFIG_LWIP_MAX_SOCKETS=40

# LWIP TCP PCB pool — every loopback tunnel stream consumes two PCBs
# (our client end + the httpd-accepted end on the same stack) plus a
# 60 s TIME_WAIT lingering after close.  Default 16 was getting blown
# the moment a browser loaded a multi-asset page through the tunnel,
# manifesting as `accept (errno 113 / EHOSTUNREACH / ERR_RTE)` because
# lwip couldn't allocate a PCB for the next connection.
CONFIG_LWIP_MAX_ACTIVE_TCP=64

# Modern browsers send 1.5–2 KB of headers per request (cookies, sec-ch-ua,
# accept-encoding…).  esp_http_server's default 512 / our previous 1024 are
# both too tight: requests through the tunnel get rejected with "Header
# fields are too long" (HTTP 431).  Each accepted connection allocates
# this buffer once, so the cost is bounded by max_open_sockets.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024

# ── Self-OTA rollback safety net ─────────────────────────────────────────
# A freshly OTA'd app boots in ESP_OTA_IMG_PENDING_VERIFY.  main/p4_ota.cpp
# runs a post-OTA self-test and only calls
# esp_ota_mark_app_valid_cancel_rollback() once the firmware proves healthy
# (heartbeats + heap floor; tunnel/LIN/BLE/IP best-effort with a time
# ceiling).  If the new image reboots/hangs before validating, the
# bootloader reverts to the previous app.  CONFIG_BOOTLOADER_WDT_ENABLE is
# already on, so a hard hang before the self-test runs still triggers the
# revert on the next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── ECDSA peripheral not present on ESP32-P4 rev < v3 (esp32p4_es) ────────
# The ECDSA hardware accelerator is missing on the pre-production silicon on
# this board, so MBEDTLS_HARDWARE_ECDSA_VERIFY makes the PSA driver log
# "ECDSA peripheral not supported on this chip revision" on every ECDSA
# verify during the TLS handshake (GitHub OTA check / WSS tunnel).  Disable
# it so cert-chain verification runs in software (mbedtls) cleanly.
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
