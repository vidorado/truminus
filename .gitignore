# EEZ Studio build cache
.eez-project-build

# VSCode — machine-specific settings (copy from settings.json.template)
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/.browse.c_cpp.db*
.vscode/ipch

# Claude Code
.claude/worktrees
.claude/settings.local.json

.cache

# idf.py / ESP-IDF native build outputs
build/
managed_components/
sdkconfig.old

# Pre-gzipped web assets — rebuilt by scripts/gen_gz.py on every build,
# stored next to their source files in data/ for the webserver to serve
# with Content-Encoding: gzip.  Build artifact, not source.
data/*.gz

# Web-asset content hash — rebuilt by scripts/gen_fs_ver.py on every build and
# baked into the LittleFS image so the self-OTA can tell whether the web
# changed.  Build artifact, not source.
data/fs.ver

# C6 co-processor slave firmware binary (built by 'make build-c6')
main/slave_fw/*.bin

# Windows NTFS Alternate Data Stream metadata that WSL surfaces as a
# sibling file when copying/downloading on a Windows host.  Never source.
*:Zone.Identifier

# EEZ Studio per-machine editor state — viewport position, zoom, which
# tab is open, which object is selected.  Doesn't affect generated UI.
*.eez-project-ui-state

# Graphify output — regenerate with `graphify update .`
# Graphify
graphify-out
