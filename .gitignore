# EEZ Studio build cache
.eez-project-build

# VSCode — machine-specific settings (copy from settings.json.template)
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/.browse.c_cpp.db*
.vscode/ipch

# Claude Code
.claude/worktrees
.claude/settings.local.json

# PlatformIO build cache (kept for local installs that still use it)
.pio/

# idf.py / ESP-IDF native build outputs
build/
managed_components/
sdkconfig.old

# Pre-gzipped web assets — rebuilt by scripts/gen_gz.py on every build,
# stored next to their source files in data/ for the webserver to serve
# with Content-Encoding: gzip.  Build artifact, not source.
data/*.gz

# C6 co-processor slave firmware binary (built by 'make build-c6')
main/slave_fw/*.bin
