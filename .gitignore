# EEZ Studio build cache
.eez-project-build

# VSCode — machine-specific settings (copy from settings.json.template)
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/.browse.c_cpp.db*
.vscode/ipch

# Claude Code
.claude/

# PlatformIO build cache (kept for local installs that still use it)
.pio/

# idf.py / ESP-IDF native build outputs
build/
managed_components/
sdkconfig.old

# Generated web asset blob (rebuilt by scripts/compress_fs.py at cmake configure)
main/webfiles.h
src/webfiles.h

# C6 co-processor slave firmware binary (built by 'make build-c6')
main/slave_fw/*.bin
